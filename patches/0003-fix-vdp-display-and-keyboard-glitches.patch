+vt100_clear$	db	ESC.asc,"[?25l",12,23,1,0,ETX.asc			; Agon / Terminal: Hide cursor & CLS
+vt100_home$	DB	ESC.asc,"[f",30,ETX.asc			; Agon / Terminal: Home Cursor
 
