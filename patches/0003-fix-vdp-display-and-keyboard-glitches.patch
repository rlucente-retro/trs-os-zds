-		JR	Z,CTL1			; Go if CTL 01
+		JP	Z,CTL1			; Go if CTL 01
 		DEC	A
 		JR	Z,CTL2			; CTL 02 "init uart"
 		CP	4-2			; Wakeup feature?
@@ -86,9 +86,13 @@
 		
 ;	Check if ready to send
 
