+++ b/TRSDOS_7/SYSRES/drivers/driver-UART0.S	2026-11-04 16:53:53
@@ -41,9 +41,9 @@
 
 CTLUART0	LD	A,C			; Get @CTL byte
 		OR	A			; @CTL 00?
