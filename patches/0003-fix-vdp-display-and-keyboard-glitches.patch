+		LD	(u0_flushed_flg),A
+		CALL	flush_u0_fifo
+u0_is_clean	IN0     A,(UART0_LSR)		; Get status of data waiting?	IN A,(UARTST)	; Check if actually RX.
 		AND     UART_DR     		; Char waiting?
 		JR      Z,nochar		; Make NZ, NO char waiting.
 			
@@ -201,9 +211,11 @@
 		;ld	b,00000000b		; Set TRS-80 modem status register to char waiting.
 
 		IN0    	A,(UART0_RBR)		; Get byte from UART0.
+		BIT	7,A			; Agon: test for VDP packet (>=0x80)
+		JR	NZ,vdp_pkt
 		LD	C,A			; Save it in C.
 			
-		cp	ESC.asc			; User hit escape? If so inc count by 1.
+norm_char	cp	ESC.asc			; User hit escape? If so inc count by 1.
 		ld	a,(esccount)
 		jr	nz,resetesc
 		dec	a
@@ -246,6 +258,89 @@
 		ld	a,c
 		cp	A			; Set Z flag.
 		ret
+
+; VDP Packet Handler for Agon Light / Fab Agon Emulator
+; VDP packets: [0x80+code] [len] [payload...]
+; Packet 0x81 (PACKET_KEYCODE): len=4, payload=[ascii, modifiers, vk_code, is_down]
+; All other packets (e.g. 0x86 PACKET_MODE, 0x89 PACKET_MOUSE) are discarded.
+
+vdp_pkt		PUSH	DE
+		LD	D,A			; D = packet code
+		CALL	u0_gb			; Read length byte
+		LD	E,A			; E = payload length
+		LD	A,D
+		CP	81h			; Is it PACKET_KEYCODE?
+		JR	NZ,vdp_discard
+
+		CALL	u0_gb			; Byte 1: ascii
+		LD	D,A			; Save ascii in D
+		CALL	u0_gb			; Byte 2: modifiers
+		CALL	u0_gb			; Byte 3: vk_code
+		CALL	u0_gb			; Byte 4: is_down
+		OR	A			; Key pressed? (1=press, 0=release)
+		JR	Z,vdp_next		; Ignore key release
+		LD	A,D			; A = ascii
+		OR	A			; Valid character?
+		JR	Z,vdp_next		; Ignore non-ascii modifier
+		POP	DE
+		LD	C,A			; Character in C
+		JP	norm_char
+
+vdp_discard	LD	A,E
+		OR	A
+		JR	Z,vdp_next
+		CALL	u0_gb
+		DEC	E
+		JR	vdp_discard
+
+vdp_next	POP	DE
+		JP	CKINP
+
+u0_gb		IN0	A,(UART0_LSR)
+		AND	UART_DR
+		JR	Z,u0_gb
+		IN0	A,(UART0_RBR)
+		RET
+
+u0_flushed_flg	db	0			; 0=not flushed yet, 1=flushed
+; Flush UART0 FIFO on initialization
+flush_u0_fifo	PUSH	BC
+fu0_loop	LD	BC,2000h
+fu0_wait	IN0	A,(UART0_LSR)
+		AND	UART_DR
+		JR	NZ,fu0_read
+		DEC	BC
+		LD	A,B
+		OR	C
+		JR	NZ,fu0_wait
+		CALL	hide_vdp_cursor
+		POP	BC
+		RET
+fu0_read	IN0	A,(UART0_RBR)
+		JR	fu0_loop
+
+; Agon VDP: send cursor-off sequence directly to UART0
+hide_vdp_cursor	PUSH	HL
+		PUSH	AF
+		PUSH	BC
+		LD	HL,vdu_cur_off_seq
+hvc_loop	LD	A,(HL)
+		INC	HL
+		CP	0FFh
+		JR	Z,hvc_done
+		LD	C,A
+		CALL	TXUART0
+		JR	hvc_loop
+hvc_done	POP	BC
+		POP	AF
+		POP	HL
+		RET
+
+vdu_cur_off_seq	db	ESC.asc, "[?25l"	; VT100: Hide cursor in fabgl::Terminal
+		db	23, 1, 0		; Agon VDU: disable text cursor
+		db	23, 0, 10, 32		; Agon VDU: CRTC reg 10 cursor off
+		db	23, 0, 11, 0		; Agon VDU: CRTC reg 11 cursor end=0
+		db	0FFh			; End of sequence
 
 ; Character PUT request. Transmit byte in register C.
 
--- a/TRSDOS_7/SYSRES/interrupts/interrupt_handler.s	2026-11-04 16:50:32
+++ b/TRSDOS_7/SYSRES/interrupts/interrupt_handler.s	2026-11-04 16:53:53
@@ -62,11 +62,15 @@
 			ld	(pumpcnt),a		; Reset counter to countdown value.
 
 			ld	hl,zspace.VIDEO$-9	; Point to video RAM.
-			ld	de,CRTSIZE+2		; Size of video screen in dec (1920).
+			ld	de,CRTSIZE+9		; Size of video screen + 9 prefix bytes.
 
-canisend1		IN0	a,(UART0_MSR)		; Get CTS status & test if CTS is ready..
-			BIT	4,A			; If other end sets CTS true, they are ready to receive.I just
-			JR	Z,canisend1		; If not ready wait. Come on I am waiting in CANISND loop.
+canisend1	nop
+			nop
+			nop
+			nop
+			nop
+			nop
+			nop
 
 			IN0	A,(UART0_LSR)		; Find out if UART ready to transmit.
 			cpl
