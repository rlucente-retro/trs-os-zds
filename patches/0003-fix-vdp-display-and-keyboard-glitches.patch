+++ b/TRSDOS_7/SYSRES/drivers/driver-UART0.S	2026-11-04 18:26:17
@@ -41,9 +41,9 @@
 
 CTLUART0	LD	A,C			; Get @CTL byte
 		OR	A			; @CTL 00?
-		JR	Z,CANISND		; Go if so
+		JP	Z,CANISND		; Go if so
