-			
-; Break, Pause and Enter handler routine.
-
-resetesc	ld	a,2			; Reset counter back to 2.
-CRCK		ld	(esccount),a
-		ld	a,c
+norm_char	ld	a,c
 		LD	HL,zKFLAG$		; KFLAG$
 		CP	CR.asc			; ENTER char received?
 		JR	NZ,PAWSCK		; Go if not
@@ -226,26 +225,168 @@
 		JR	NZ,BRKCHK		; Go if not
 		SET	1,(HL)			; Set pause bit
 		JR	RECVEX
-BRKCHK		LD	A,(IX+LOGBRK)		; Break char received?
-		OR	A			; Check if LOGBRK=0
-		JR	Z,RECVEX		; No valid break if =0
-		CP	C			; Check if a valid break
-		JR	NZ,RECVEX		; Go if so.
+BRKCHK		CP	ESC.asc			; Escape (<Break>)?
+		JR	Z,BRKRECD
+		CP	03H			; Ctrl-C?
+		JR	Z,BRKRECD
+		CP	(IX+LOGBRK)		; Logical break char?
+		JR	Z,BRKRECD
+		JR	RECVEX			; Else normal character
 
 ; A break was received, check system's BREAK disable
 
-BRKRECD		LD	A,(zSFLAG$)		; Check if break key.
+BRKRECD		LD	A,(zSFLAG$)		; Check if break key
 		AND	10H			; is disabled
 		LD	A,00H			; Ret NZ & A=0 if
 		RET	NZ			; the BREAK is disabled
 		LD	HL,zKFLAG$		; Hang onto flag
-		SET	0,(HL)			; Else set break bit
-		LD	C,80H			; & reset BREAK code
+		SET	0,(HL)			; Set break bit
+		LD	C,80H			; & return TRS-80 BREAK code (80h)
 RECVEX		LD	(IX+CLBUF),C		; Put char in 1 char buf
 		LD	(IX+CLFLG),80H		; Set char available
 		ld	a,c
 		cp	A			; Set Z flag.
 		ret
+
+; VDP Packet Handler for Agon Light / Fab Agon Emulator
+; VDP packets: [0x80+code] [len] [payload...]
+; Packet 0x81 (PACKET_KEYCODE): len=2 or len=4
+;   len=2: payload=[ascii, 0]
+;   len=4: payload=[ascii, modifiers, vk_code, is_down]
+; All other packets (e.g. 0x86 PACKET_MODE, 0x89 PACKET_MOUSE) are discarded.
+
+vdp_pkt		PUSH	DE
+		LD	D,A			; D = packet code
+		CALL	u0_gb			; Read length byte
+		LD	E,A			; E = payload length
+		LD	A,D
+		CP	81h			; Is it PACKET_KEYCODE?
+		JR	NZ,vdp_discard
+
+		LD	A,E
+		OR	A
+		JR	Z,vdp_next		; Empty payload
+
+		; Read Byte 1: ascii
+		CALL	u0_gb
+		LD	C,A			; C = ascii
+		DEC	E
+		JR	Z,vdp_eval		; Length 1
+
+		; Read Byte 2: modifiers
+		CALL	u0_gb
+		LD	D,A			; D = modifiers
+		DEC	E
+		JR	Z,vdp_eval		; Length 2 (sendKeycodeByte: [ascii, 0])
+
+		; Read Byte 3: vk_code
+		CALL	u0_gb
+		LD	B,A			; B = vk_code
+		DEC	E
+		JR	Z,vdp_eval		; Length 3
+
+		; Read Byte 4: is_down
+		CALL	u0_gb
+		DEC	E
+		PUSH	AF			; Save is_down
+
+		; Drain any remaining bytes (if E > 0)
+vdp_drn_lp	LD	A,E
+		OR	A
+		JR	Z,vdp_drn_dn
+		CALL	u0_gb
+		DEC	E
+		JR	vdp_drn_lp
+vdp_drn_dn	POP	AF			; Restore is_down
+		OR	A			; Pressed (1) or released (0)?
+		JR	Z,vdp_next		; Ignore key release!
+
+vdp_eval	; Character in C, modifiers in D, vk_code in B
+		LD	A,C
+		OR	A			; Is ASCII non-zero?
+		JR	NZ,vdp_has_char		; Valid ASCII character!
+
+		; ASCII is 0: check if Ctrl+C or Escape was pressed
+		LD	A,B			; Virtual key code
+		CP	1Bh			; VK_ESCAPE
+		JR	Z,vdp_is_esc
+		RES	5,A			; 'c' -> 'C'
+		CP	'C'
+		JR	NZ,vdp_next		; Not 'c' or 'C'
+		INC	D
+		DEC	D			; Modifiers active?
+		JR	Z,vdp_next		; Bare 'c' with ascii=0
+		LD	C,03h			; Synthesize Ctrl-C
+		JR	vdp_has_char
+
+vdp_is_esc	LD	C,1Bh			; Synthesize Escape
+		JR	vdp_has_char
+
+vdp_has_char	POP	DE
+		JP	norm_char
+
+vdp_discard	LD	A,E
+		OR	A
+		JR	Z,vdp_next
+		CALL	u0_gb
+		DEC	E
+		JR	vdp_discard
+
+vdp_next	POP	DE
+		JP	CKINP
+
+u0_gb		PUSH	BC
+		LD	B,0			; Timeout loop counter (256 iterations)
+u0_gblp		IN0	A,(UART0_LSR)
+		AND	UART_DR
+		JR	NZ,u0_gbok
+		DJNZ	u0_gblp
+		POP	BC
+		XOR	A			; Timeout: return 0
+		RET
+u0_gbok		IN0	A,(UART0_RBR)
+		POP	BC
+		RET
+
+u0_flushed_flg	db	0			; 0=not flushed yet, 1=flushed
+; Flush UART0 FIFO on initialization
+flush_u0_fifo	PUSH	BC
+fu0_loop	LD	BC,2000h
+fu0_wait	IN0	A,(UART0_LSR)
+		AND	UART_DR
+		JR	NZ,fu0_read
+		DEC	BC
+		LD	A,B
+		OR	C
+		JR	NZ,fu0_wait
+		CALL	hide_vdp_cursor
+		POP	BC
+		RET
+fu0_read	IN0	A,(UART0_RBR)
+		JR	fu0_loop
+
+; Agon VDP: send cursor-off sequence directly to UART0
+hide_vdp_cursor	PUSH	HL
+		PUSH	AF
+		PUSH	BC
+		LD	HL,vdu_cur_off_seq
+hvc_loop	LD	A,(HL)
+		INC	HL
+		CP	0FFh
+		JR	Z,hvc_done
+		LD	C,A
+		CALL	TXUART0
+		JR	hvc_loop
+hvc_done	POP	BC
+		POP	AF
+		POP	HL
+		RET
+
+vdu_cur_off_seq	db	ESC.asc, "[?25l"	; VT100: Hide cursor in fabgl::Terminal
+		db	23, 1, 0		; Agon VDU: disable text cursor
+		db	23, 0, 10, 32		; Agon VDU: CRTC reg 10 cursor off
+		db	23, 0, 11, 0		; Agon VDU: CRTC reg 11 cursor end=0
+		db	0FFh			; End of sequence
 
 ; Character PUT request. Transmit byte in register C.
 
