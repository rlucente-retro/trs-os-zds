@@ -0,0 +1,113 @@
+		SUBTITLE	"<DriveWire Storage Driver>"
+		newpage
+
+; ==============================================================================
+; driver-DWDVR.s - FujiNet / DriveWire 3/4 Sector Driver for TRS-OS (TRSDOS 7)
+;
+; Provides sector read via DriveWire OP_READEX (0xD2) and write-protection
+; enforcement for remote virtual disk images over eZ80 UART1.
+; ==============================================================================
+
+; DriveWire Protocol State Variables
+dw_slot		db	0				; Virtual device slot (0..7)
+dw_offset	db	1,0,0,0,0,0,0,0			; Container offset: 1 for DiskDISK (+256B header), 0 for JV1
+dw_hdr		db	0D2h,0,0,0,0			; 5-byte OP_READEX request header: [opcode, slot, LSN23..16, LSN15..8, LSN7..0]
+dw_chk		db	0,0				; 2-byte big-endian checksum [MSB, LSB]
+dw_status	db	0				; 1-byte status return (0x00 = success)
+
+; ------------------------------------------------------------------------------
+; rd_drivewire - Read 256-byte sector over DriveWire via UART1
+;
+; Entry:
+;   Stack: [saved HL (destination buffer)], [saved DE (track/sector)], [saved BC], [saved HL]
+;   (fdc_no_sum): 16-bit logical sector number calculated by calcsec
+;   (LDRV$): requested logical drive (0..7)
+; Exit:
+;   Success: jumps to rd_finish (pops DE, checks system cylinder, restores regs, returns)
+;   Failure: jumps to fdc_rd_err (pops buffer, DE, BC, HL, returns A=03h NZ)
+; ------------------------------------------------------------------------------
+rd_drivewire:
+		ld	a,(LDRV$)			; Logical drive number (0..7)
+		ld	(dw_slot),a			; Direct 1:1 slot mapping
+		ld	(dw_hdr+1),a			; Virtual device slot in packet header
+
+		; Add container offset (0 for raw JV1, 1 for DiskDISK header)
+		ld	e,a
+		ld	d,0
+		ld	hl,dw_offset
+		add	hl,de
+		ld	e,(hl)				; E = offset (0 or 1)
+		ld	hl,(fdc_no_sum)			; HL = calculated LSN
+		add	hl,de				; HL = wire LSN on server
+
+		; Prepare 5-byte OP_READEX request header (opcode 0xD2 and MSB 0x00 are static)
+		ld	a,h
+		ld	(dw_hdr+3),a			; LSN [15..8]
+		ld	a,l
+		ld	(dw_hdr+4),a			; LSN [7..0]
+
+		; Flush UART1 RX/TX FIFOs before request
+		ld	a,07h
+		out0	(UART1_FCTL),a
+
+		; Transmit 5-byte request header over UART1
+		UART1.put.bytes 5,dw_hdr,fdc_rd_timeout
+
+		; Receive 256-byte sector data directly into target buffer
+		pop	hl				; Recover user destination buffer pointer
+		push	hl				; Save for checksum
+		UART1.get.bytes 0,hl,fdc_rd_timeout	; Length 0 = 256 bytes
+
+		; Calculate 16-bit big-endian unsigned checksum
+		pop	hl				; Recover buffer pointer
+		push	hl				; Keep on stack for rd_finish
+		call	calc_dw_checksum		; Computes sum: D=MSB, E=LSB
+		ld	a,d
+		ld	(dw_chk+0),a
+		ld	a,e
+		ld	(dw_chk+1),a
+
+		; Transmit 2-byte checksum to server
+		UART1.put.bytes 2,dw_chk,fdc_rd_timeout
+
+		; Receive 1-byte status from server (0x00 = success)
+		UART1.get.bytes 1,dw_status,fdc_rd_timeout
+		ld	a,(dw_status)
+		or	a
+		jp	nz,fdc_rd_err
+
+		pop	hl				; Clean up buffer pointer from stack
+		jp	rd_finish			; Clean exit via authentic LS-DOS handler
+
+; ------------------------------------------------------------------------------
+; wr_drivewire - Write 256-byte sector over DriveWire (Stage 1/2: Read-Only)
+;
+; Entry:
+;   Stack: [saved BC], [saved HL]
+; Exit:
+;   Returns A=15 (R_PROTECTED / Write Protected) with NZ set
+; ------------------------------------------------------------------------------
+wr_drivewire:
+		pop	bc				; Recovered from save on entry to driver
+		pop	hl				; Per Soltoff restore on exit registers used
+		ld	a,15				; Error 15 = R_PROTECTED (Write Protected)
+		or	a				; Set NZ for error
+		ei
+		ret
+
+; ------------------------------------------------------------------------------
+; calc_dw_checksum - 16-bit big-endian checksum over 256 bytes at (HL)
+;
+; Returns: D = MSB, E = LSB, HL advanced by 256
+; ------------------------------------------------------------------------------
+calc_dw_checksum:
+		ld	de,0				; DE = 16-bit sum
+		ld	b,0				; 256 iterations
+dw_chk_loop:	ld	a,(hl)
+		inc	hl
+		add	a,e
+		ld	e,a
+		jr	nc,dw_chk_nocarry
+		inc	d
+dw_chk_nocarry:	djnz	dw_chk_loop
+		ret
