-DEVICE.serialnet.baud	EQU	230400	; Starting UART1 baudrate.
+DEVICE.serialnet.baud	EQU	115200	; Starting UART1 baudrate (Olimex MOD-WIFI-ESP8266 default).	; Starting UART1 baudrate.
 
 f91_console_baud	EQU 	((_SYS_CLK_FREQ / DEVICE.console.baud) /16)	; Default baud rate for f91.
-f92_console_baud	EQU 	((20000000 / DEVICE.console.baud) /16)		; Default baud rate for f92.
+f92_console_baud	EQU 	((18432000 / DEVICE.console.baud) /16)		; Default baud rate for f92 (Olimex Agon Light 2 18.432 MHz).		; Default baud rate for f92.
 
-f91_serialnet_baud	EQU 	((_SYS_CLK_FREQ / DEVICE.serialnet.baud) /16)	; Default baud rate for f91.
-f92_serialnet_baud	EQU 	((20000000 / DEVICE.serialnet.baud) /16)	; Default baud rate for f92.
+f91_serialnet_baud	EQU 	((18432000 / DEVICE.serialnet.baud) /16)	; Default baud rate for f91 on Agon Light 2.	; Default baud rate for f91.
+f92_serialnet_baud	EQU 	((18432000 / DEVICE.serialnet.baud) /16)	; Default baud rate for f92 on Agon Light 2.	; Default baud rate for f92.
 
