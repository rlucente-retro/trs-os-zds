 ; driver-SDDVR.s - Local MicroSD Card SPI0 Block Driver for TRS-OS (TRSDOS 7)
 ; Target Platform: Olimex Agon Light 2 (Zilog eZ80F92 @ 18.432 MHz)
 ;
-; Provides raw physical sector read and write protection for .dsk disk images
-; residing on the Agon Light 2 on-board microSD card via hardware SPI0.
+; Provides raw physical 512-byte block Read (CMD17) and Read-Modify-Write
+; (CMD17 + CMD24) for .dsk disk images residing on the Agon Light 2 microSD
+; card via hardware SPI0.
 ;
 ; Block Translation:
 ;   SD card physical blocks = 512 bytes
 ;   TRSDOS logical sectors   = 256 bytes (1 SD block = 2 TRSDOS sectors)
-;   SD Block LBA = BaseLBA + (LSN / 2)
-;   Sub-sector   = LSN & 1 (0 = lower 256 bytes, 1 = upper 256 bytes)
+;   SD Block LBA = BaseLBA + ((LSN + dw_offset[drive]) / 2)
+;   Sub-sector   = (LSN + dw_offset[drive]) & 1 (0 = lower 256B, 1 = upper 256B)
+;
+; Memory Layout (below INTERRUPT.handler at 0xF600):
+;   0xF200..0xF2FF : sd_rmw_buf (256-byte sibling sub-sector buffer)
+;   0xF300..0xF3FF : sddvr_write_sector (CMD17/CMD24 RMW write driver)
+;   0xF400..0xF447 : Fixed lowcore mailbox (sddvr_inited, sddvr_base_lba,
+;                    sddvr_map_lba @ 0xF428, sddvr_map_len @ 0xF42C)
+;   0xF448..0xF5F4 : sddvr_init, SPI0 helpers, sddvr_read_sector
 ; ==============================================================================
 
-; SD SPI Command Definitions
+; SD SPI Command & Token Definitions
 CMD17_READ_BLOCK	EQU	40h + 17	; 0x51: READ_SINGLE_BLOCK
 CMD24_WRITE_BLOCK	EQU	40h + 24	; 0x58: WRITE_SINGLE_BLOCK
-DATA_START_TOKEN	EQU	0FEh		; Data token for Single Block Read
-
-; ------------------------------------------------------------------------------
-; Driver State & Working Storage
-; ------------------------------------------------------------------------------
+DATA_START_TOKEN	EQU	0FEh		; Data start token (CMD17 & CMD24)
+
+; ------------------------------------------------------------------------------
+; 0xF200..0xF2FF: 256-Byte Sibling Sub-Sector Buffer for 512B Read-Modify-Write
+; ------------------------------------------------------------------------------
+sd_rmw_buf:		ds	256
+
+; ------------------------------------------------------------------------------
+; sddvr_write_sector - Write 256-byte sector via 512-byte SD Read-Modify-Write
+;
+; Entry:
+;   Stack: [saved HL (source buffer)], [saved DE (track/sector)], [saved BC], [saved HL]
+;   IY: DCTx$ pointer (bit 7 of (IY+3) = Write Protect)
+;   (fdc_no_sum): 16-bit logical sector number calculated by calcsec
+;   (LDRV$): requested logical drive (0..7)
+;   Preserves IX (LS-DOS holds active FCB pointer in IX across driver calls).
+; Exit:
+;   Success: restores DE, BC, HL; returns A=0 (Z set), EI
+;   RO/WP:   restores DE, BC, HL; returns A=15 (R_PROTECTED, NZ set), EI
+;   Error:   restores DE, BC, HL; returns A=14 (Write Fault, NZ set), EI
+; ------------------------------------------------------------------------------
+sddvr_write_sector:
+		; 0. Enforce DCT write-protect flag (bit 7 of DCT+3)
+		bit	7,(iy+3)
+		jp	nz,sd_wr_prot
+
+		; 1. Ensure hardware SPI0 is initialized
+		ld	a,(sddvr_inited)
+		or	a
+		call	z,sddvr_init
+
+		; 2. Compute 32-bit SD Block LBA and sub-sector selector
+		call	sd_prep_lba
+		jp	c,sd_wr_err
+
+		; 3. Phase 1 (Read): CMD17 read of existing 512B block, retaining
+		;    the sibling 256B half in sd_rmw_buf.
+		ld	a,CMD17_READ_BLOCK
+		call	sd_send_cmd
+		jp	c,sd_wr_err
+		call	sd_wait_fe
+		jp	c,sd_wr_err
+
+		ld	hl,sd_rmw_buf
+		ld	a,(sd_subsector)
+		or	a
+		jr	nz,sd_w_keep_lo
+
+		; Writing lower half (0): discard lower 256B, keep upper 256B
+		call	sd_disc_256
+		call	sd_rx_256
+		jr	sd_w_rd_crc
+
+		; Writing upper half (1): keep lower 256B, discard upper 256B
+sd_w_keep_lo:	call	sd_rx_256
+		call	sd_disc_256
+
+sd_w_rd_crc:	call	spi_kick			; Discard 2-byte CRC
+		call	spi_kick
+		call	sd_deselect			; Finish CMD17 cleanly
+
+		; 4. Phase 2 (Write): CMD24 write merged 512B block back to same LBA
+		ld	a,CMD24_WRITE_BLOCK
+		call	sd_send_cmd			; sd_cmd_buf+1..4 still holds LBA
+		jp	c,sd_wr_err
+
+		call	spi_kick			; Nwr >= 1 idle byte before token
+		ld	a,DATA_START_TOKEN		; 0xFE
+		call	spi_tx_rx
+
+		pop	hl				; Recover caller 256B write buffer
+		push	hl				; Keep copy on stack for cleanup
+		ld	a,(sd_subsector)
+		or	a
+		jr	nz,sd_w_tx_upper
+
+		; Sub-sector 0: TX caller buffer (lower), then sd_rmw_buf (upper)
+		call	sd_tx_256
+		ld	hl,sd_rmw_buf
+		call	sd_tx_256
+		jr	sd_w_tx_crc
+
+		; Sub-sector 1: TX sd_rmw_buf (lower), then caller buffer (upper)
+sd_w_tx_upper:	push	hl
+		ld	hl,sd_rmw_buf
+		call	sd_tx_256
+		pop	hl
+		call	sd_tx_256
+
+		; 5. Send 2-byte dummy CRC & verify Data Response Token (xxx00101b)
+		;    Note: fab-agon-emulator emits 0x05 on data byte 512 (currently in A)
+		;    and 0x01 on CRC byte 1; real SD cards emit 0xFF on both and send
+		;    0xE5 after CRC byte 2. Capture A, drain CRC bytes, then validate.
+sd_w_tx_crc:	ld	c,a				; Save MISO from data byte 512
+		call	spi_kick			; CRC byte 1 (drains emulator 0x01)
+		call	spi_kick			; CRC byte 2
+		ld	b,a				; Save MISO from CRC byte 2
+		ld	a,c
+		cp	0FFh
+		jr	nz,sd_w_chk_resp		; Emulator token on byte 512
+		ld	a,b
+		cp	0FFh
+		jr	nz,sd_w_chk_resp		; Token on CRC byte 2
+		ld	b,32
+sd_w_wait_resp:	call	spi_kick			; Real hardware: poll post-CRC
+		cp	0FFh
+		jr	nz,sd_w_chk_resp
+		djnz	sd_w_wait_resp
+		call	sd_deselect
+		jp	sd_wr_err
+
+sd_w_chk_resp:	and	1Fh
+		cp	05h				; 00101b = Data Accepted
+		jr	z,sd_w_wait_busy
+		call	sd_deselect
+		jp	sd_wr_err
+
+		; 6. Wait for SD flash programming busy (MISO low -> 0xFF idle)
+sd_w_wait_busy:	ld	d,4				; Up to ~450 ms @ 4.6 MHz SPI0
+sd_w_busy_out:	ld	bc,0
+sd_w_busy_in:	call	spi_kick
+		cp	0FFh
+		jr	z,sd_w_done
+		dec	bc
+		ld	a,b
+		or	c
+		jr	nz,sd_w_busy_in
+		dec	d
+		jr	nz,sd_w_busy_out
+		call	sd_deselect
+		jp	sd_wr_err
+
+sd_w_done:	call	sd_deselect
+		pop	hl				; Discard caller buffer ptr
+		pop	de				; Restore track/sector DE
+		pop	bc				; Restore entry BC
+		pop	hl				; Restore entry HL
+		xor	a				; A=0, Z set (success)
+		ei
+		ret
+
+sd_wr_prot:	pop	hl
+		pop	de
+		pop	bc
+		pop	hl
+		ld	a,15				; Error 15 = R_PROTECTED
+		or	a				; NZ
+		ei
+		ret
+
+sd_wr_err:	pop	hl
+		pop	de
+		pop	bc
+		pop	hl
+		ld	a,14				; Error 14 = Write Fault
+		or	a				; NZ
+		ei
+		ret
+
+; ==============================================================================
+; Fixed Lowcore Mailbox Region (0xF400) -- ABI locked with FNBOOT/SDMOUNT/DRVMAP
+; ==============================================================================
+		ORG	0F400h
+
 sddvr_inited:	db	0				; 0 = uninitialized, 1 = initialized
 sd_subsector:	db	0				; Sub-sector selector (0 or 1)
-sd_cmd_buf:	db	0, 0, 0, 0, 0, 0FFh		; 6-byte CMD17 packet buffer
+sd_cmd_buf:	db	0, 0, 0, 0, 0, 0FFh		; 6-byte CMD17/CMD24 packet buffer
 
 ; 8-entry table of 32-bit physical starting LBAs (1 per logical drive :0..:7)
-; Populated at mount time by pre-boot launcher (FNBOOT) or in-DOS SDMOUNT.
-; Little-endian: [LSB, byte1, byte2, MSB]
+; Note: ZDS dd reserves 8B/item -> 64B (0xF408..0xF447), housing:
+;   sddvr_base_lba : 0xF408..0xF427 (8 x 4B LE)
+;   sddvr_map_lba  : 0xF428..0xF42B (4B LE)
+;   sddvr_map_len  : 0xF42C..0xF42D (2B LE)
 sddvr_base_lba:
-		dd	0, 0, 0, 0, 0, 0, 0, 0		; 32 bytes (8 drives x 4 bytes)
+		dd	0, 0, 0, 0, 0, 0, 0, 0
 
